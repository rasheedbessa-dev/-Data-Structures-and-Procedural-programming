ALGORITHM SommeElementsDistincts
VAR
    ensemble1 : ARRAY[4] OF INTEGER := [3, 1, 7, 9]
    ensemble2 : ARRAY[5] OF INTEGER := [2, 4, 1, 9, 3]
    somme : INTEGER := 0
    i, j : INTEGER
    present : BOOLEAN
BEGIN
    // Parcourir les éléments du premier ensemble
    FOR i := 0 TO 3 DO
        present := False
        FOR j := 0 TO 4 DO
            IF ensemble1[i] = ensemble2[j] THEN
                present := True
            END_IF
        END_FOR
        IF present = False THEN
            somme := somme + ensemble1[i]
        END_IF
    END_FOR

    // Parcourir les éléments du deuxième ensemble
    FOR i := 0 TO 4 DO
        present := False
        FOR j := 0 TO 3 DO
            IF ensemble2[i] = ensemble1[j] THEN
                present := True
            END_IF
        END_FOR
        IF present = False THEN
            somme := somme + ensemble2[i]
        END_IF
    END_FOR

    Write("Somme des éléments distincts = ", somme)
END

