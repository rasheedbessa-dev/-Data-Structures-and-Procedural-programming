PROCEDURE dot_product(v1 : ARRAY OF REAL, v2 : ARRAY OF REAL, n : INTEGER, Var ps : REAL)
VAR
    i : INTEGER
BEGIN
    ps := 0
    FOR i := 0 TO n-1 DO
        ps := ps + v1[i] * v2[i]
    END_FOR
END_PROCEDURE
ALGORITHM OrthogonalVectors
VAR
    v1, v2 : ARRAY[3] OF REAL
    ps : REAL
BEGIN
    // Exemple de vecteurs
    v1 := [1, 2, -1]
    v2 := [2, -1, 1]

    // Appel de la procédure
    dot_product(v1, v2, 3, ps)

    IF ps = 0 THEN
        Write("Les vecteurs sont orthogonaux")
    ELSE
        Write("Les vecteurs ne sont pas orthogonaux")
    END_IF
END

FUNCTION dot_product(v1 : ARRAY OF REAL, v2 : ARRAY OF REAL, n : INTEGER) : REAL
VAR
    i : INTEGER
    somme : REAL := 0
BEGIN
    FOR i := 0 TO n-1 DO
        somme := somme + v1[i] * v2[i]
    END_FOR
    RETURN somme
END_FUNCTION

ALGORITHM OrthogonalVectorsAvecFonction
VAR
    v1, v2 : ARRAY[3] OF REAL
    ps : REAL
BEGIN
    v1 := [1, 2, -1]
    v2 := [2, -1, 1]

    ps := dot_product(v1, v2, 3)

    IF ps = 0 THEN
        Write("Les vecteurs sont orthogonaux")
    ELSE
        Write("Les vecteurs ne sont pas orthogonaux")
    END_IF
END

